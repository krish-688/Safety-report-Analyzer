# Copy to backend/.env (or project root .env) and edit.
DATABASE_URL=sqlite:///./safety.db
# PostgreSQL: postgresql+psycopg://user:pass@localhost:5432/safety
# MySQL:      mysql+pymysql://user:pass@localhost:3306/safety
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DEMO_PASSWORD=Demo@12345
